{
  "name": "clotho-desktop",
  "version": "1.0.0",
  "description": "Clotho Material Analysis desktop application",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "37.0.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.clotho.material-analysis",
    "productName": "Clotho Material Analysis",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/clotho-backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Clotho-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
